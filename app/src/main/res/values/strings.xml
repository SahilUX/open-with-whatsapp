    <string name="app_name">Open in WhatsApp</string>

    <string name="how_it_works">Tap any phone number on your phone, then pick \"Open in WhatsApp\" from the list of apps. The number is converted to international format and the chat opens straight away.</string>
    <string name="country_code_label">Country code for local numbers</string>
    <string name="country_code_hint">971</string>
    <string name="country_code_help">Numbers starting with 0 (like 050 123 4567) get this code. Numbers that already carry a country code are left exactly as they are.</string>
